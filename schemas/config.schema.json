{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "listen": {
      "description": "May be omitted; defaults to 0.0.0.0:8080, or override with --listen.",
      "type": "string",
      "default": "0.0.0.0:8080"
    },
    "bot_token": {
      "description": "May be omitted when provided with --bot-token; the merged value must be non-empty.",
      "type": "string",
      "default": ""
    },
    "default_chat_id": {
      "description": "May be provided with --default-chat-id.",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "templates_dir": {
      "description": "May be omitted; defaults to templates, or override with --templates-dir.",
      "type": "string",
      "default": ""
    },
    "telegram_api_url": {
      "type": "string",
      "default": "https://api.telegram.org"
    },
    "api_secrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoints": {
      "description": "Extra POST routes; each renders a fixed template from the whole request body.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EndpointConfig"
      },
      "default": []
    },
    "otlp": {
      "$ref": "#/$defs/OtlpConfig",
      "default": {
        "endpoint": null,
        "service_name": "bakanotifier",
        "sampling_ratio": 1.0
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "api_secrets"
  ],
  "$defs": {
    "EndpointConfig": {
      "description": "A custom POST route. The request body is used as the template `values`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "URL path starting with `/`, for example `/alerts`.",
          "type": "string"
        },
        "template": {
          "description": "Template name, without the extension, rendered for every request.",
          "type": "string"
        },
        "chat_id": {
          "description": "Chat id for this endpoint; defaults to default_chat_id when omitted.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "template"
      ]
    },
    "OtlpConfig": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_name": {
          "type": "string",
          "default": "bakanotifier"
        },
        "sampling_ratio": {
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false
    }
  }
}
